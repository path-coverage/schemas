 [55, 59, "k"], [60, 61, "n"]]}, {"text": "    if not order.get(\"express\"):", "tokens": [[4, 6, "k"], [7, 10, "k"], [21, 30, "s"]]}, {"text": "        shipping //= 2", "tokens": [[21, 22, "n"]]}, {"text": "    if order.get(\"gift\") and (", "tokens": [[4, 6, "k"], [17, 23, "s"], [25, 28, "k"]]}, {"text": "        order.get(\"wrap\") or user.get(\"member\")", "tokens": [[18, 24, "s"], [26, 28, "k"], [38, 46, "s"]]}, {"text": "    ):", "tokens": []}, {"text": "        total += 3", "tokens": [[17, 18, "n"]]}, {"text": "    else:", "tokens": [[4, 8, "k"]]}, {"text": "        total += 1 if order.get(\"gift\") else 0", "tokens": [[17, 18, "n"], [19, 21, "k"], [32, 38, "s"], [40, 44, "k"], [45, 46, "n"]]}, {"text": "    if order.get(\"pickup\"):", "tokens": [[4, 6, "k"], [17, 25, "s"]]}, {"text": "        return total", "tokens": [[8, 14, "k"]]}, {"text": "    return total + shipping", "tokens": [[4, 10, "k"]]}, {"text": "", "tokens": []}, {"text": "", "tokens": []}, {"text": "def discounts(rates):", "tokens": [[0, 3, "k"]]}, {"text": "    \"\"\"A function that defines a function inside it, the discount off a", "tokens": [[4, 71, "s"]]}, {"text": "    total, None for no rates.\"\"\"", "tokens": [[0, 32, "s"]]}, {"text": "    if not rates:", "tokens": [[4, 6, "k"], [7, 10, "k"]]}, {"text": "        return None", "tokens": [[8, 14, "k"], [15, 19, "k"]]}, {"text": "", "tokens": []}, {"text": "    def discount(total, rate):", "tokens": [[4, 7, "k"]]}, {"text": "        \"\"\"The discount off total at rate, at most 20.\"\"\"", "tokens": [[8, 57, "s"]]}, {"text": "        off = total * rate if rate > 0 and total > 0 else 0", "tokens": [[27, 29, "k"], [37, 38, "n"], [39, 42, "k"], [51, 52, "n"], [53, 57, "k"], [58, 59, "n"]]}, {"text": "        if off > 20:", "tokens": [[8, 10, "k"], [17, 19, "n"]]}, {"text": "            return 20", "tokens": [[12, 18, "k"], [19, 21, "n"]]}, {"text": "        return off", "tokens": [[8, 14, "k"]]}, {"text": "", "tokens": []}, {"text": "    return discount", "tokens": [[4, 10, "k"]]}, {"text": "", "tokens": []}, {"text": "", "tokens": []}, {"text": "def labels(items):", "tokens": [[0, 3, "k"]]}, {"text": "    \"\"\"Choices inside a comprehension, which runs once for each item: a", "tokens": [[4, 71, "s"]]}, {"text": "    conditional expression whose else arm is another.\"\"\"", "tokens": [[0, 56, "s"]]}, {"text": "    return [", "tokens": [[4, 10, "k"]]}, {"text": "        \"bargain\" if item[\"sale\"] and item[\"price\"] < 10 else \"sale\" if item[\"sale\"] else \"full price\"", "tokens": [[8, 17, "s"], [18, 20, "k"], [26, 32, "s"], [34, 37, "k"], [43, 50, "s"], [54, 56, "n"], [57, 61, "k"], [62, 68, "s"], [69, 71, "k"], [77, 83, "s"], [85, 89, "k"], [90, 102, "s"]]}, {"text": "        for item in items", "tokens": [[8, 11, "k"], [17, 19, "k"]]}, {"text": "    ]", "tokens": []}, {"text": "", "tokens": []}, {"text": "", "tokens": []}, {"text": "def on_sale(items):", "tokens": [[0, 3, "k"]]}, {"text": "    \"\"\"The items on sale: a comprehension's filter.\"\"\"", "tokens": [[4, 54, "s"]]}, {"text": "    return [item for item in items if item[\"sale\"]]", "tokens": [[4, 10, "k"], [17, 20, "k"], [26, 28, "k"], [35, 37, "k"], [43, 49, "s"]]}, {"text": "", "tokens": []}, {"text": "", "tokens": []}, {"text": "def size(order):", "tokens": [[0, 3, "k"]]}, {"text": "    \"\"\"A match of how many items an order has.\"\"\"", "tokens": [[4, 49, "s"]]}, {"text": "    match len(order[\"items\"]):", "tokens": [[20, 27, "s"]]}, {"text": "        case 0:", "tokens": [[13, 14, "n"]]}, {"text": "            return \"empty\"", "tokens": [[12, 18, "k"], [19, 26, "s"]]}, {"text": "        case 1 | 2:", "tokens": [[13, 14, "n"], [17, 18, "n"]]}, {"text": "            return \"small\"", "tokens": [[12, 18, "k"], [19, 26, "s"]]}, {"text": "        case count if count > 10:", "tokens": [[19, 21, "k"], [30, 32, "n"]]}, {"text": "            return \"large\"", "tokens": [[12, 18, "k"], [19, 26, "s"]]}, {"text": "        case _:", "