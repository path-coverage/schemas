]]},{"text":"       (order[:wrap] || user[:member])","tokens":[[14,19,"s"],[21,23,"o"],[29,36,"s"]]},{"text":"      total += 3","tokens":[[15,16,"n"]]},{"text":"    else","tokens":[[4,8,"k"]]},{"text":"      total += 0 if order[:gift]","tokens":[[15,16,"n"],[17,19,"k"],[26,31,"s"]]},{"text":"    end","tokens":[[4,7,"k"]]},{"text":"","tokens":[]},{"text":"    return total if order[:pickup]","tokens":[[4,10,"k"],[17,19,"k"],[26,33,"s"]]},{"text":"","tokens":[]},{"text":"    total + shipping","tokens":[]},{"text":"  end","tokens":[[2,5,"k"]]},{"text":"","tokens":[]},{"text":"  # A method that defines a method inside it.","tokens":[[2,45,"c"]]},{"text":"  def self.install_discounts(rates)","tokens":[[2,5,"k"],[6,10,"k"]]},{"text":"    if rates.empty?","tokens":[[4,6,"k"]]},{"text":"      return","tokens":[[6,12,"k"]]},{"text":"    end","tokens":[[4,7,"k"]]},{"text":"","tokens":[]},{"text":"    def self.discount(total, rate)","tokens":[[4,7,"k"],[8,12,"k"]]},{"text":"      off = 0","tokens":[[12,13,"n"]]},{"text":"      if rate.positive? && total.positive?","tokens":[[6,8,"k"],[24,26,"o"]]},{"text":"        off = total * rate","tokens":[]},{"text":"      end","tokens":[[6,9,"k"]]},{"text":"      if off > 20","tokens":[[6,8,"k"],[15,17,"n"]]},{"text":"        off = 20","tokens":[[14,16,"n"]]},{"text":"      end","tokens":[[6,9,"k"]]},{"text":"      off","tokens":[]},{"text":"    end","tokens":[[4,7,"k"]]},{"text":"","tokens":[]},{"text":"    if rates.size > 1 || rates.first > 0.5","tokens":[[4,6,"k"],[20,21,"n"],[22,24,"o"],[39,42,"n"]]},{"text":"      @tiered = true","tokens":[[6,13,"v"],[16,20,"k"]]},{"text":"    end","tokens":[[4,7,"k"]]},{"text":"  end","tokens":[[2,5,"k"]]},{"text":"","tokens":[]},{"text":"  # Choices inside a block, which runs once for each item.","tokens":[[2,58,"c"]]},{"text":"  def self.labels(items)","tokens":[[2,5,"k"],[6,10,"k"]]},{"text":"    items.map do |item|","tokens":[[14,16,"k"]]},{"text":"      if item[:sale] && item[:price] < 10","tok